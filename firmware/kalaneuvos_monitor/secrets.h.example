// Copy this file to "secrets.h" in the same folder and fill in your own values.
// secrets.h is gitignored — never commit real credentials or keys.
#ifndef SECRETS_H
#define SECRETS_H

#include <pgmspace.h>

// 1. Network Credentials Configuration
const char WIFI_SSID[] = "YOUR_WIFI_SSID";
const char WIFI_PASSWORD[] = "YOUR_WIFI_PASSWORD";

// 2. Regional AWS IoT Data Endpoint Gateway
// Found in AWS IoT Core -> Settings -> Device data endpoint
const char AWS_IOT_ENDPOINT[] = "your-endpoint-ats.iot.your-region.amazonaws.com";

// 3. Amazon Root CA 1 Authentication Certificate
// Download from: https://www.amazontrust.com/repository/AmazonRootCA1.pem
static const char AWS_CERT_CA[] PROGMEM = R"KEY(
-----BEGIN CERTIFICATE-----
PASTE_AMAZON_ROOT_CA_1_HERE
-----END CERTIFICATE-----
)KEY";

// 4. Client X.509 Device Security Certificate
// Generated per-device when you create a "Thing" in AWS IoT Core
static const char AWS_CERT_CRT[] PROGMEM = R"KEY(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_DEVICE_CERTIFICATE_HERE
-----END CERTIFICATE-----
)KEY";

// 5. Private RSA Device Encryption Key
// Generated alongside the device certificate above — download once, store safely
static const char AWS_CERT_PRIVATE[] PROGMEM = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
PASTE_YOUR_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----
)KEY";

// 6. Blynk Credentials (from your Blynk.Cloud template)
#define BLYNK_TEMPLATE_ID   "YOUR_BLYNK_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "YOUR_BLYNK_TEMPLATE_NAME"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

#endif
